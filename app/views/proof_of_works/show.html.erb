<% content_for :title, @proof_of_work.title %>

<section class="dashboard-hero">
  <p class="dashboard-eyebrow">Career Gym</p>
  <h1><%= @proof_of_work.title %></h1>
  <p class="dashboard-trajectory">Evidence of applied engineering work</p>
</section>

<section class="dashboard-panel">
  <h2>Proof Details</h2>
  <p><strong>Skill:</strong> <%= @proof_of_work.skill.name %></p>
  <p><strong>Lab:</strong> <%= @proof_of_work.engineering_lab.title %></p>
  <p><strong>Proof:</strong> <%= @proof_of_work.proof_type_label %></p>
  <p><strong>Completed:</strong> <%= @proof_of_work.completed_at.strftime("%b %Y") %></p>
</section>

<section class="dashboard-panel">
  <h2>Description</h2>
  <%= simple_format(@proof_of_work.description) %>
</section>

<section class="dashboard-panel">
  <h2>Evidence</h2>
  <% if @proof_of_work.url.present? %>
    <p><%= link_to "Open Evidence", @proof_of_work.url, class: "dashboard-link", target: "_blank", rel: "noopener" %></p>
  <% else %>
    <p>This proof is private and does not have a public URL.</p>
  <% end %>

  <p>
    <%= link_to "Open Lab", lab_path(@proof_of_work.engineering_lab), class: "dashboard-link" %>
    <%= link_to "Edit", edit_proof_of_work_path(@proof_of_work), class: "dashboard-link" %>
  </p>
</section>
