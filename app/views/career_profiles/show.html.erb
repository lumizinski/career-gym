<% content_for :title, "Career Profile" %>

<% if @career_profile.present? %>
  <h1>Career Profile</h1>

  <%= render @career_profile %>

  <p><%= link_to "Edit", edit_career_profile_path %></p>
<% else %>
  <h1>Career Profile</h1>
  <p>You have not created a career profile yet.</p>
  <p><%= link_to "Create Career Profile", new_career_profile_path %></p>
<% end %>
