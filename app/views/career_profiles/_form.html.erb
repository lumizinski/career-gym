<%= form_with(model: career_profile, url: career_profile_path) do |form| %>
  <% if career_profile.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(career_profile.errors.count, "error") %> prohibited this career profile from being saved:</h2>
      <ul>
        <% career_profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :current_role, style: "display: block" %>
    <%= form.text_field :current_role %>
  </div>

  <div>
    <%= form.label :years_of_experience, style: "display: block" %>
    <%= form.number_field :years_of_experience, min: 0 %>
  </div>

  <div>
    <%= form.label :target_role, style: "display: block" %>
    <%= form.text_field :target_role %>
  </div>

  <div>
    <%= form.label :target_market, style: "display: block" %>
    <%= form.text_field :target_market %>
  </div>

  <div>
    <%= form.label :goals, style: "display: block" %>
    <%= form.text_area :goals %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
