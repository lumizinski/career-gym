<div id="<%= dom_id career_profile %>">
  <div>
    <strong>User:</strong>
    <%= career_profile.user_id %>
  </div>

  <div>
    <strong>Current role:</strong>
    <%= career_profile.current_role %>
  </div>

  <div>
    <strong>Years of experience:</strong>
    <%= career_profile.years_of_experience %>
  </div>

  <div>
    <strong>Target role:</strong>
    <%= career_profile.target_role %>
  </div>

  <div>
    <strong>Target market:</strong>
    <%= career_profile.target_market %>
  </div>

  <div>
    <strong>Goals:</strong>
    <%= career_profile.goals %>
  </div>

</div>
