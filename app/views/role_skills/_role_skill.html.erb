<div id="<%= dom_id role_skill %>">
  <div>
    <strong>Role:</strong>
    <%= role_skill.role.title %>
  </div>

  <div>
    <strong>Skill:</strong>
    <%= role_skill.skill.name %>
  </div>

  <div>
    <strong>Required level:</strong>
    <%= role_skill.required_level %>/10
  </div>

  <div>
    <strong>Importance:</strong>
    <%= role_skill.importance %>
  </div>
</div>
