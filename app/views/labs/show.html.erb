<% content_for :title, @lab.title %>

<section class="dashboard-hero">
  <p class="dashboard-eyebrow">Career Gym</p>
  <h1><%= @lab.title %></h1>
  <p class="dashboard-trajectory"><%= @lab.description %></p>
</section>

<section class="dashboard-panel">
  <p><strong>Skill:</strong> <%= @lab.skill.name %></p>
  <p><strong>Current level:</strong> <%= @current_skill_level %>/10</p>
  <p>
    <strong>Target level:</strong>
    <% if @target_skill_level.present? %>
      <%= @target_skill_level %>/10
    <% else %>
      Not set yet
    <% end %>
  </p>
</section>

<section class="dashboard-panel">
  <h2>Objective</h2>
  <%= simple_format(@lab.objective) %>
</section>

<section class="dashboard-panel">
  <h2>Deliverables</h2>
  <% if @lab.deliverables.any? %>
    <ul>
      <% @lab.deliverables.each do |deliverable| %>
        <li>☐ <%= deliverable %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No deliverables defined yet.</p>
  <% end %>
</section>

<section class="dashboard-panel">
  <h2>Status</h2>
  <p><%= @lab.status.humanize.titleize %></p>

  <p>
    <%= link_to "Edit Lab", edit_lab_path(@lab), class: "dashboard-link" %>
    <% unless @lab.completed? %>
      <%= button_to "Mark as Completed", complete_lab_path(@lab), method: :patch, class: "dashboard-button" %>
    <% end %>
  </p>
</section>

<section class="dashboard-panel" id="proof-of-work">
  <h2>Proof of Work</h2>

  <% if @lab.completed? %>
    <% if @proof_of_works.any? %>
      <% @proof_of_works.each do |proof| %>
        <article>
          <p>✓ <strong><%= proof.proof_type_label %></strong></p>
          <p><%= proof.title %></p>
          <p><%= link_to "Open", proof_of_work_path(proof), class: "dashboard-link" %></p>
        </article>
      <% end %>
    <% else %>
      <p>No proof attached yet.</p>
    <% end %>

    <p><%= link_to "Add Proof of Work", new_lab_proof_of_work_path(@lab), class: "dashboard-link" %></p>
  <% else %>
    <p>Complete this lab to attach proof of work.</p>
  <% end %>
</section>
