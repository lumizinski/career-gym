<% content_for :title, "Edit Skill Assessment" %>

<h1>Edit Skill Assessment</h1>

<%= form_with(model: @user_skill) do |form| %>
  <% if @user_skill.errors.any? %>
    <div style="color: red">
      <ul>
        <% @user_skill.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :skill_id, "Skill", style: "display: block" %>
    <%= form.collection_select :skill_id, @available_skills, :id, ->(skill) { "#{skill.category}: #{skill.name}" } %>
  </div>

  <div>
    <%= form.label :level, style: "display: block" %>
    <%= form.number_field :level, in: 1..10 %>
  </div>

  <div>
    <%= form.label :confidence, style: "display: block" %>
    <%= form.number_field :confidence, in: 1..10 %>
  </div>

  <div>
    <%= form.submit "Update Skill" %>
  </div>
<% end %>
