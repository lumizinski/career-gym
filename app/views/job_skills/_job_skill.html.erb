<div id="<%= dom_id job_skill %>">
  <div>
    <strong>Job:</strong>
    <%= job_skill.job.title %>
  </div>

  <div>
    <strong>Skill:</strong>
    <%= job_skill.skill.name %>
  </div>

  <div>
    <strong>Required level:</strong>
    <%= job_skill.required_level %>/10
  </div>

  <div>
    <strong>Importance:</strong>
    <%= job_skill.importance %>
  </div>
</div>
