<%= form_with(model: job_skill) do |form| %>
  <% if job_skill.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(job_skill.errors.count, "error") %> prohibited this job skill from being saved:</h2>
      <ul>
        <% job_skill.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :job_id, "Job", style: "display: block" %>
    <%= form.collection_select :job_id, Job.order(:title), :id, :title, prompt: "Select a role" %>
  </div>

  <div>
    <%= form.label :skill_id, "Skill", style: "display: block" %>
    <%= form.collection_select :skill_id, Skill.order(:category, :name), :id, :name, prompt: "Select a skill" %>
  </div>

  <div>
    <%= form.label :required_level, style: "display: block" %>
    <%= form.number_field :required_level, in: 1..10 %>
  </div>

  <div>
    <%= form.label :importance, style: "display: block" %>
    <%= form.select :importance, JobSkill::IMPORTANCE_ORDER.keys %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
