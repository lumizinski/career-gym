<% content_for :title, "Career Dashboard" %>

<section class="dashboard-hero">
  <p class="dashboard-eyebrow">Career Gym</p>

  <% if @career_profile.present? %>
    <h1><%= @career_profile.current_role %></h1>
    <p class="dashboard-trajectory">→ <%= @career_profile.target_role %></p>
  <% else %>
    <h1>Your career dashboard</h1>
    <p class="dashboard-trajectory">Create your profile to unlock your training plan.</p>
  <% end %>

  <dl class="dashboard-summary-grid">
    <div class="dashboard-summary-card">
      <dt>Skills assessed</dt>
      <dd><%= @skills_count %></dd>
    </div>
    <div class="dashboard-summary-card">
      <dt>Average level</dt>
      <dd>
        <% if @average_skill_level.present? %>
          <%= number_with_precision(@average_skill_level, precision: 1) %>/10
        <% else %>
          Not available yet
        <% end %>
      </dd>
    </div>
    <div class="dashboard-summary-card">
      <dt>Skill gaps</dt>
      <dd><%= @skill_gaps.count %></dd>
    </div>
    <div class="dashboard-summary-card">
      <dt>Profile</dt>
      <dd><%= @career_profile.present? ? "Complete" : "Incomplete" %></dd>
    </div>
  </dl>
</section>

<div class="dashboard-grid">
<section class="dashboard-panel" id="this-week">
  <h2>THIS WEEK</h2>

  <% if @top_focus_skill.present? %>
    <p><span aria-hidden="true">🎯</span> Focus on <strong><%= @top_focus_skill.skill.name %></strong></p>
    <p><%= @top_focus_skill.current_level %>/10 → <%= @top_focus_skill.target_level %>/10</p>
    <p><%= pluralize(@top_focus_remaining_training_items, "training activity") %> remaining</p>
    <p><%= link_to "View Weekly Focus", focus_path, class: "dashboard-link" %></p>
  <% else %>
    <p>Set your target role and skill requirements to get your weekly focus.</p>
    <p><%= link_to "View Weekly Focus", focus_path, class: "dashboard-link" %></p>
  <% end %>
</section>

<section class="dashboard-panel" id="career-profile">
  <h2>Career Profile</h2>

  <% if @career_profile.present? %>
    <dl class="dashboard-details">
      <div>
        <dt>Current role</dt>
        <dd><%= @career_profile.current_role %></dd>
      </div>
      <div>
        <dt>Years of experience</dt>
        <dd><%= @career_profile.years_of_experience %></dd>
      </div>
      <div>
        <dt>Target role</dt>
        <dd><%= @career_profile.target_role %></dd>
      </div>
      <div>
        <dt>Target market</dt>
        <dd><%= @career_profile.target_market %></dd>
      </div>
      <div>
        <dt>Goals</dt>
        <dd><%= @career_profile.goals %></dd>
      </div>
    </dl>
    <p><%= link_to "Edit Profile", edit_career_profile_path, class: "dashboard-link" %></p>
  <% else %>
    <p>You have not created your career profile yet.</p>
    <p><%= link_to "Create Career Profile", new_career_profile_path, class: "dashboard-link" %></p>
  <% end %>
</section>

<section class="dashboard-panel" id="skill-gaps">
  <h2>Skill Gaps</h2>

  <% if @skill_gaps.any? %>
    <ol class="dashboard-gap-list">
      <% @skill_gaps.each do |user_skill| %>
        <li>
          <span><%= user_skill.skill.name %></span>
          <strong><%= user_skill.level %>/10</strong>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p>No skill gaps right now. Keep stretching toward your target role.</p>
  <% end %>
</section>

<section class="dashboard-panel" id="training">
  <h2>Training</h2>
  <p><%= @training_item_counts[:completed] %> items completed</p>
  <p><%= @training_item_counts[:in_progress] %> items in progress</p>
  <p><%= @training_item_counts[:pending] %> items remaining</p>

  <% if @highest_priority_training_gap.present? %>
    <p>Highest priority: <strong><%= @highest_priority_training_gap.skill.name %></strong></p>
  <% end %>

  <p><%= link_to "Continue Training", training_index_path, class: "dashboard-link" %></p>
</section>

<section class="dashboard-panel" id="engineering-labs">
  <h2>Engineering Labs</h2>
  <p><%= @engineering_lab_counts[:completed] %> completed</p>
  <p><%= @engineering_lab_counts[:in_progress] %> in progress</p>
  <p><%= @engineering_lab_counts[:pending] %> pending</p>

  <% if @latest_engineering_lab.present? %>
    <p>Latest: <strong><%= @latest_engineering_lab.title %></strong></p>
    <p><%= @latest_engineering_lab.status.humanize %></p>
  <% else %>
    <p>Start a practical workout from your training plan.</p>
  <% end %>

  <p><%= link_to "View Labs", labs_path, class: "dashboard-link" %></p>
</section>

<section class="dashboard-panel" id="proof-of-work">
  <h2>Proof of Work</h2>

  <% if @proof_of_work_count.positive? %>
    <p><%= pluralize(@proof_of_work_count, "piece") %> of evidence</p>
    <% @proof_of_work_type_counts.sort_by { |proof_type, _count| ProofOfWork.proof_type_label_for(proof_type) }.each do |proof_type, count| %>
      <p><%= count %> <%= ProofOfWork.proof_type_label_for(proof_type).pluralize(count) %></p>
    <% end %>
  <% else %>
    <p>No evidence attached yet.</p>
  <% end %>

  <p><%= link_to "View Proof of Work", proof_of_works_path, class: "dashboard-link" %></p>
</section>
</div>

<section class="dashboard-panel" id="skills">
  <h2>Skills</h2>

  <% if @skills_by_category.present? %>
    <% @skills_by_category.each do |category, user_skills| %>
      <section class="dashboard-skill-category">
        <h3><%= category %></h3>
        <div class="dashboard-skill-grid">
          <% user_skills.each do |user_skill| %>
            <article class="dashboard-skill-card">
              <div class="dashboard-skill-header">
                <h4><%= user_skill.skill.name %></h4>
                <%= link_to "Edit", edit_user_skill_path(user_skill), class: "dashboard-link" %>
              </div>
              <p class="dashboard-level">
                <span aria-hidden="true" class="dashboard-level-bar"><%= level_bar(user_skill.level) %></span>
                <span><%= user_skill.level %>/10</span>
              </p>
              <p>Confidence: <strong><%= confidence_label(user_skill.confidence) %></strong></p>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <p>No skills assessed yet.</p>
  <% end %>
</section>

<section class="dashboard-panel">
  <h3>Add Skill Assessment</h3>
  <%= form_with model: @user_skill, url: user_skills_path do |form| %>
    <% if @user_skill.errors.any? %>
      <div class="dashboard-errors">
        <ul>
          <% @user_skill.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :skill_id, "Skill", class: "dashboard-label" %>
      <%= form.collection_select :skill_id, @available_skills, :id, ->(skill) { "#{skill.category}: #{skill.name}" }, prompt: "Select a skill" %>
    </div>

    <div>
      <%= form.label :level, class: "dashboard-label" %>
      <%= form.number_field :level, in: 1..10 %>
    </div>

    <div>
      <%= form.label :confidence, class: "dashboard-label" %>
      <%= form.number_field :confidence, in: 1..10 %>
    </div>

    <div>
      <%= form.submit "Add Skill", class: "dashboard-button" %>
    </div>
  <% end %>
</section>
