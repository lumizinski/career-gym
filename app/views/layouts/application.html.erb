<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Career Gym" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Career Gym">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice.present? %>
      <p role="status" aria-live="polite" style="color: green"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p role="alert" aria-live="assertive" style="color: red"><%= alert %></p>
    <% end %>

    <% if user_signed_in? %>
      <p>
        Signed in as <%= current_user.email %> |
        <%= link_to "Dashboard", career_dashboard_path %> |
        <%= link_to "Skill Gap Analysis", skill_gaps_path %> |
        <%= link_to "Training", training_index_path %> |
        <%= link_to "Engineering Labs", labs_path %> |
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete } %>
      </p>
    <% else %>
      <p><%= link_to "Sign in", new_user_session_path %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
